# Setup Default States For Exfoliation
ChuckOff
delay 50
VacNozzleOff
delay 50
RetractNozzle
delay 50
ExtendStamp
delay 50
ExtendChipStage
delay 50

# Go to Chip Grab Chip
MoveX CHIP_X
MoveY CHIP_Y
delay 5500
ExtendNozzle
delay 1000
VacNozzleOn
delay 1000
RetractNozzle
delay 1000

# Go to Stage Place Down
MoveX STAGE_X
delay 5500
