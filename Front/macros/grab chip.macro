delay 1000
ChuckOn
delay 500
VacNozzleOff
delay 250
RetractNozzle
delay 1000 

delay 3000

# Pickup From Stage
ExtendNozzle
delay 1000
VacNozzleOn
delay 500
ChuckOff
delay 250
RetractNozzle
delay 1000

# Move and Place Chip Back
MoveX CHIP_X
MoveY CHIP_Y
delay 5500
