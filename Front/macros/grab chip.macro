# Setup Default States For Exfoliation
ChuckOff
delay 50
VacNozzleOff
delay 50
RetractNozzle
delay 50
ExtendStamp
delay 50
ExtendChipStage
delay 50

# Go to Chip Grab Chip
MoveX CHIP_X
delay 2000
MoveY CHIP_Y
delay 2000
ExtendNozzle
delay 1000
VacNozzleOn
delay 1000
MoveX CHIP_X + 0.6
delay 1000
MoveY CHIP_Y - 0.6
delay 1000
RetractNozzle
delay 1000

# Go to Stage Place Down
MoveX 8.0
delay 2000
ExtendNozzle
delay 1000
ChuckOn
delay 500
VacNozzleOff
delay 250
RetractNozzle
delay 1000 

delay 3000

# Pickup From Stage
ExtendNozzle
delay 1000
VacNozzleOn
delay 500
ChuckOff
delay 250
RetractNozzle
delay 1000

# Move and Place Chip Back
MoveX CHIP_X + 0.45
delay 1000
MoveY CHIP_Y - 0.45
delay 1000
ExtendNozzle
delay 500
VacNozzleOff
delay 500
RetractNozzle
delay 500 
